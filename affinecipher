def affine_encrypt(text, a, b):
    result = ""

    for ch in text.lower():
        if ch.isalpha():
            p = ord(ch) - ord('a')
            c = (a * p + b) % 26
            result += chr(c + ord('a'))

    return result


def affine_decrypt(cipher, a, b):
    result = ""

    inverse = pow(a, -1, 26)

    for ch in cipher.lower():
        if ch.isalpha():
            c = ord(ch) - ord('a')
            p = (inverse * (c - b)) % 26
            result += chr(p + ord('a'))

    return result


text = "hello"
a = 15
b = 20

cipher = affine_encrypt(text, a, b)

print("Cipher:", cipher)
print("Plaintext:", affine_decrypt(cipher, a, b))
