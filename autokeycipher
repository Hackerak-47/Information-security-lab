# Autokey Cipher

def encrypt(plaintext, key):
    plaintext = plaintext.replace(" ", "").upper()

    # Convert initial numeric key to a letter value
    key_stream = [key]

    # Add plaintext values to extend the key
    for ch in plaintext[:-1]:
        key_stream.append(ord(ch) - ord('A'))

    ciphertext = ""

    for i in range(len(plaintext)):
        p = ord(plaintext[i]) - ord('A')
        k = key_stream[i]

        c = (p + k) % 26
        ciphertext += chr(c + ord('A'))

    return ciphertext


def decrypt(ciphertext, key):
    ciphertext = ciphertext.replace(" ", "").upper()

    plaintext = ""

    # First character uses the initial key
    p = ((ord(ciphertext[0]) - ord('A')) - key) % 26
    plaintext += chr(p + ord('A'))

    # After that, use already recovered plaintext
    for i in range(1, len(ciphertext)):
        c = ord(ciphertext[i]) - ord('A')
        k = ord(plaintext[i - 1]) - ord('A')

        p = (c - k) % 26
        plaintext += chr(p + ord('A'))

    return plaintext


# Input
plaintext = input("Enter plaintext: ")
key = int(input("Enter initial key: "))

ciphertext = encrypt(plaintext, key)

print("Ciphertext:", ciphertext)
print("Decrypted text:", decrypt(ciphertext, key))
