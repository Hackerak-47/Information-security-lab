from cryptography.hazmat.primitives.asymmetric import dh
import time

# Key generation
start = time.perf_counter()

parameters = dh.generate_parameters(
    generator=2,
    key_size=2048
)

key_gen_time = time.perf_counter() - start

# Alice's key pair
alice_private = parameters.generate_private_key()
alice_public = alice_private.public_key()

# Bob's key pair
bob_private = parameters.generate_private_key()
bob_public = bob_private.public_key()

# Key exchange
start = time.perf_counter()

alice_shared = alice_private.exchange(bob_public)
bob_shared = bob_private.exchange(alice_public)

exchange_time = time.perf_counter() - start

print("Alice shared secret:", alice_shared.hex())
print("Bob shared secret  :", bob_shared.hex())

print("Key generation time:", key_gen_time)
print("Key exchange time:", exchange_time)

if alice_shared == bob_shared:
    print("Shared secret established successfully!")
