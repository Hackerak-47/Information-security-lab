import numpy as np

key = np.array([
    [6, 24, 1],
    [13, 16, 10],
    [20, 17, 15]
])

def encrypt(text):
    text = text.replace(" ", "").upper()

    # Padding
    while len(text) % 3 != 0:
        text += "X"

    cipher = ""

    for i in range(0, len(text), 3):
        block = []

        for ch in text[i:i+3]:
            block.append(ord(ch) - ord('A'))

        result = np.dot(key, block) % 26

        for x in result:
            cipher += chr(int(x) + ord('A'))

    return cipher


def decrypt(cipher):
    # Find inverse of key modulo 26
    det = round(np.linalg.det(key))
    det = det % 26

    det_inv = pow(det, -1, 26)

    # Adjugate
    adj = np.round(det * np.linalg.inv(key)).astype(int) % 26

    inverse_key = (det_inv * adj) % 26

    plaintext = ""

    for i in range(0, len(cipher), 3):
        block = []

        for ch in cipher[i:i+3]:
            block.append(ord(ch) - ord('A'))

        result = np.dot(inverse_key, block) % 26

        for x in result:
            plaintext += chr(int(x) + ord('A'))

    return plaintext


text = input("Enter plaintext: ")

cipher = encrypt(text)

print("Ciphertext:", cipher)
print("Decrypted text:", decrypt(cipher))
