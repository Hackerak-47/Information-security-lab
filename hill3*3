import numpy as np
from math import gcd

key = np.array([
    [6, 24, 1],
    [13, 16, 10],
    [20, 17, 15]
])


def mod_inverse(a, m):
    for x in range(1, m):
        if (a * x) % m == 1:
            return x
    return None


def matrix_inverse_mod26(matrix):
    det = round(np.linalg.det(matrix))
    det = det % 26

    # Check whether inverse exists
    if gcd(det, 26) != 1:
        print("Key matrix has no inverse modulo 26")
        return None

    det_inv = mod_inverse(det, 26)

    # Calculate adjugate
    adj = np.zeros((3, 3), dtype=int)

    for i in range(3):
        for j in range(3):

            minor = np.delete(np.delete(matrix, i, axis=0), j, axis=1)

            minor_det = round(np.linalg.det(minor))

            adj[j][i] = ((-1) ** (i + j)) * minor_det

    inverse_key = (det_inv * adj) % 26

    return inverse_key


def encrypt(text):
    text = text.replace(" ", "").upper()

    while len(text) % 3 != 0:
        text += "X"

    cipher = ""

    for i in range(0, len(text), 3):

        block = []

        for ch in text[i:i+3]:
            block.append(ord(ch) - ord('A'))

        result = np.dot(key, block) % 26

        for x in result:
            cipher += chr(int(x) + ord('A'))

    return cipher


def decrypt(cipher, inverse_key):
    plaintext = ""

    for i in range(0, len(cipher), 3):

        block = []

        for ch in cipher[i:i+3]:
            block.append(ord(ch) - ord('A'))

        result = np.dot(inverse_key, block) % 26

        for x in result:
            plaintext += chr(int(x) + ord('A'))

    return plaintext


text = input("Enter plaintext: ")

inverse_key = matrix_inverse_mod26(key)

print("Inverse Matrix:")
print(inverse_key)

cipher = encrypt(text)

print("Ciphertext:", cipher)
print("Decrypted text:", decrypt(cipher, inverse_key))
