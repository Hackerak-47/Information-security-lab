text = input("Enter plaintext: ")
text = text.replace(" ", "").upper()

rows = 2
cols = (len(text) + rows - 1) // rows

# Fill matrix row-wise
matrix = []
index = 0

for i in range(rows):
    row = []
    for j in range(cols):
        if index < len(text):
            row.append(text[index])
            index += 1
        else:
            row.append("X")
    matrix.append(row)

# Read column-wise
cipher = ""

for j in range(cols):
    for i in range(rows):
        cipher += matrix[i][j]

print("Ciphertext:", cipher)
